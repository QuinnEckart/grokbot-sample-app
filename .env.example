# Copy to .env locally if you use a dotenv loader (optional). App Platform uses the control panel / spec envs.

# Required for chat (server-side only — never commit the real value)
# MODEL_ACCESS_KEY=

# Optional inference overrides
# INFERENCE_MODEL=openai-gpt-oss-20b
# INFERENCE_BASE_URL=https://inference.do-ai.run/v1

# HTTP port (Docker / local)
# PORT=8080

# Optional: max chat POSTs per client IP per rolling minute (default 30)
# CHAT_RATE_LIMIT_PER_MINUTE=30
